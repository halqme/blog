---
const links = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "https://apps.0w0.foo", label: "Gallery↗" },
]
---

<header
  class="mx-auto flex h-12 w-full max-w-5xl items-center justify-between px-6 select-none md:px-12"
>
  <div aria-hidden="true" />
  <div class="flex items-baseline gap-2">
    <nav aria-label="メインナビゲーション">
      <ul class="inline-flex gap-4">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class={"link-nav flex-inline items-center gap-1"}
                aria-current={
                  Astro.url.pathname.startsWith(link.href) && link.href !== "/"
                    ? "page"
                    : undefined
                }
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
